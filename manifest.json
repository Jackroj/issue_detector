{
  "manifest_version": 3,
  "name": "Issue Detector",
  "version": "0.1.0",
  "description": "Framework-agnostic browser-side detector for failed/slow/duplicate requests, JS errors, and performance issues.",
  "minimum_chrome_version": "111",

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Issue Detector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background/index.js"
  },

  "options_page": "options/options.html",
  "devtools_page": "devtools/devtools.html",

  "permissions": ["webRequest", "webNavigation", "storage"],
  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_start"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
